{
  "version": "0.0.0",
  "author": "Informatics Matters Ltd",
  "name": "@squonk/openapi-js-client-generator",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/InformaticsMatters/squonk2-openapi-js-client-generator"
  },
  "description": "TypeScript client for the Squonk OpenAPI files. Generated from the Open API spec with orval. Provides React Hooks to fetch data with react-query using Axios under-the-hood.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "orval": "orval",
    "build": "tsdown",
    "test": "tsc --noEmit -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "js-yaml": "4.3.2",
    "orval": "8.22.0",
    "prettier": "3.8.3",
    "react": "19.2.6",
    "ts-morph": "28.0.0",
    "tsdown": "0.22.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "axios": ">=0.23",
    "react": ">=18",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "sideEffects": false,
    "access": "public"
  }
}
